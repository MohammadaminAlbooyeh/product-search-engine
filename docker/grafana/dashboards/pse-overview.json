{
  "annotations": { "list": [] },
  "editable": true,
  "graphTooltip": 0,
  "panels": [
    {
      "type": "timeseries",
      "title": "HTTP request rate",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "PSE-PROMETHEUS" },
      "targets": [
        {
          "expr": "sum(rate(http_server_requests_seconds_count{application=\"product-search-engine\"}[5m])) by (uri, status)",
          "legendFormat": "{{uri}} {{status}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "HTTP p95 latency",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "PSE-PROMETHEUS" },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(http_server_requests_seconds_bucket{application=\"product-search-engine\"}[5m])) by (le, uri))",
          "legendFormat": "{{uri}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Search latency (p50 / p95)",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "PSE-PROMETHEUS" },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum(rate(pse_search_latency_seconds_bucket[5m])) by (le, cache))",
          "legendFormat": "p50 cache={{cache}}",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.95, sum(rate(pse_search_latency_seconds_bucket[5m])) by (le, cache))",
          "legendFormat": "p95 cache={{cache}}",
          "refId": "B"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Crawl items / alerts fired",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "PSE-PROMETHEUS" },
      "targets": [
        {
          "expr": "sum(rate(pse_crawl_items_total[15m])) by (seller)",
          "legendFormat": "crawl {{seller}}",
          "refId": "A"
        },
        {
          "expr": "sum(rate(pse_alerts_fired_total[15m]))",
          "legendFormat": "alerts",
          "refId": "B"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "JVM heap used",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "PSE-PROMETHEUS" },
      "targets": [
        {
          "expr": "sum(jvm_memory_used_bytes{application=\"product-search-engine\", area=\"heap\"})",
          "legendFormat": "heap",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Circuit / JVM threads",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "PSE-PROMETHEUS" },
      "targets": [
        {
          "expr": "jvm_threads_live_threads{application=\"product-search-engine\"}",
          "legendFormat": "live threads",
          "refId": "A"
        }
      ]
    }
  ],
  "refresh": "30s",
  "schemaVersion": 39,
  "tags": ["product-search-engine"],
  "templating": { "list": [] },
  "time": { "from": "now-1h", "to": "now" },
  "title": "Product Search Engine - Overview",
  "uid": "pse-overview",
  "version": 1
